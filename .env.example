# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# ==============================================================================
# DATABASE (PostgreSQL 16)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_db?schema=public"

# ==============================================================================
# REDIS & BULLMQ
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Settings (Zero Hardcoding)
WORKER_CONCURRENCY=10
DEFAULT_MIN_DELAY_SECONDS=2
DEFAULT_MAX_EMAILS_PER_HOUR=200

# ==============================================================================
# ELASTICSEARCH 8
# ==============================================================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

# ==============================================================================
# ETHEREAL SMTP (Fake Email Testing)
# If left empty, system automatically calls nodemailer.createTestAccount() on startup
# ==============================================================================
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ==============================================================================
# GOOGLE OAUTH 2.0
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JWT & Token Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# SLACK OAUTH & NOTIFICATIONS
# ==============================================================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
